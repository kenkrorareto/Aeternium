# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key: SOLO en servidor (Vercel env, nunca en el cliente)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin (panel de gestión)
ADMIN_PASSWORD=change-me
# Cadena aleatoria larga para firmar la cookie de sesión
AUTH_SECRET=change-me-to-a-long-random-string

# Nombres de los buckets de Storage
SUPABASE_CHARACTERS_BUCKET=characters
SUPABASE_MAPS_BUCKET=maps
